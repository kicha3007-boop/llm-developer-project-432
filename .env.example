# Пример параметров окружения. Скопируйте в .env и поправьте под себя: cp .env.example .env

# База данных (PostgreSQL + pgvector из docker-compose.yml)
DATABASE_URL=postgresql://card:card@localhost:5432/card
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_S=10

# Модель по OpenAI-совместимому API: LM Studio (:1234), Ollama (:11434/v1) или OpenRouter
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
# Основная модель — генерация карточки; дешёвая — проверка, детектор инъекций, судья
LLM_MODEL=qwen2.5-7b-instruct
LLM_CHEAP_MODEL=qwen2.5-3b-instruct
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
# json_schema — передавать схему ответа в response_format; off — только текстом в инструкции
LLM_STRUCTURED_OUTPUT=json_schema
# Сколько раз лечить невалидный ответ модели (повтор с текстом ошибки)
LLM_REPAIR_ATTEMPTS=2
# Цены за 1 млн токенов (в условных единицах, например USD). Локальная модель — 0
LLM_PRICE_INPUT_PER_1M=0.20
LLM_PRICE_OUTPUT_PER_1M=0.60
LLM_CHEAP_PRICE_INPUT_PER_1M=0.05
LLM_CHEAP_PRICE_OUTPUT_PER_1M=0.10

# Движок устойчивого исполнения (Temporal из docker-compose.yml)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=card-queue

# Локальные эмбеддинги (sentence-transformers). Префиксы — из карточки модели
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_BATCH_SIZE=32

# Поиск и сборка контекста
RELEVANCE_THRESHOLD=0.80
SEARCH_TOP_K=8
CONTEXT_MAX_CHARS=6000

# Порог уверенности: ниже — карточка ждёт человека
CONFIDENCE_THRESHOLD=0.7

# Загрузка документов
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=20971520

# Защита: сколько подозрительных фрагментов в документе допустимо до отправки документа человеку
INJECTION_MAX_SUSPICIOUS_PER_DOC=2

# Логи: JSON-строки (true) или цветной вывод для консоли (false); копия в файл, если задан
LOG_JSON=false
LOG_LEVEL=INFO
LOG_FILE=
